# API-ключ для доступа к llama-server (Authorization: Bearer <key>).
# Обязательно задайте непустое значение в Railway — иначе сервер поднимется без авторизации.
LLM_API_KEY=

# Порт, на котором слушает llama-server. Railway подставляет свой PORT автоматически.
PORT=8080

# Куда сохранять/откуда читать модель. Если в Railway подключён Volume — укажите путь внутри него,
# чтобы модель не перекачивалась при каждом рестарте.
MODEL_PATH=/models/model.gguf

# Откуда скачивать модель при старте контейнера, если её нет по MODEL_PATH.
MODEL_URL=https://huggingface.co/Vikhrmodels/Vikhr-Llama-3.2-1B-instruct-GGUF/resolve/main/Vikhr-Llama-3.2-1B-Q4_K_M.gguf

# Размер контекста llama-server.
CTX_SIZE=2048

# Количество потоков инференса.
THREADS=2

# Температура сэмплинга по умолчанию.
TEMP=0.3
