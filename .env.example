# API-ключ для доступа к llama-server (Authorization: Bearer <key>).
# Обязательно задайте непустое значение — иначе сервер поднимется без авторизации.
LLM_API_KEY=

# Порт, на котором слушает llama-server внутри контейнера.
PORT=8080

# Куда сохранять/откуда читать модель — путь внутри именованного volume
# (`beta-text-models` в compose.yml), чтобы модель не перекачивалась при рестарте.
MODEL_PATH=/models/model.gguf

# Откуда скачивать модель при старте контейнера, если её нет по MODEL_PATH.
MODEL_URL=https://huggingface.co/Vikhrmodels/Vikhr-Llama-3.2-1B-instruct-GGUF/resolve/main/Vikhr-Llama-3.2-1B-Q4_K_M.gguf

# Размер контекста llama-server.
CTX_SIZE=2048

# Количество потоков инференса.
THREADS=2

# Температура сэмплинга по умолчанию.
LLM_TEMPERATURE=0.3

# Параллелизм llama-server (число слотов инференса).
PARALLEL=1

# --- docker-compose (локальный запуск всей системы) --------------------
# Эти ключи compose.yml прокидывает поверх apps/alpha-orchestrator/.env,
# apps/telegram-bot/.env и apps/gamma-decision/.env, чтобы alpha-orchestrator
# и beta-text (LLM_API_KEY), alpha-orchestrator и gamma-decision (LAYA_API_KEY),
# и alpha-orchestrator и telegram-bot (HARNESS_API_KEY) всегда были согласованы
# между собой — не нужно вручную синхронизировать значения в разных .env файлах.
# Значения могут быть любыми непустыми строками для локальной разработки.
HARNESS_API_KEY=local-dev-harness-key
# alpha-orchestrator ↔ admin (apps/admin-api → /v1/admin/*). Must differ from HARNESS_API_KEY.
ADMIN_API_KEY=local-dev-admin-key
# alpha-orchestrator ↔ delta-function-call (llama-server API_KEY). Обязателен: compose не стартует без него.
FUNCTION_CALL_API_KEY=local-dev-function-call-key

# Cloudflare Tunnel для webhook telegram-bot (compose-сервис `tunnel`, профиль `tunnel` —
# не стартует по умолчанию, запуск: `docker compose --profile tunnel up -d tunnel`):
# `cloudflared tunnel token <имя>`, либо base64 {a: AccountTag, t: TunnelID, s: TunnelSecret}
# из ~/.cloudflared/<tunnel-id>.json. Public hostname туннеля = TELEGRAM_WEBHOOK_URL бота.
CLOUDFLARE_TUNNEL_TOKEN=
LAYA_API_KEY=local-dev-laya-key

# Gemini web-API MCP server (compose profile `gemini`, apps/gemini-webapi-mcp).
# Cookies of gemini.google.com — DevTools → Application → Cookies:
# __Secure-1PSID and __Secure-1PSIDTS. They grant access to the WHOLE Google
# account: use a separate account, never your main one.
GEMINI_PSID=
GEMINI_PSIDTS=
# Bearer token for http://127.0.0.1:8765/mcp (e.g. `openssl rand -hex 32`).
GEMINI_MCP_API_KEY=

# --- Какие модели крутятся локально в compose -----------------------------
# beta = beta-text (ответная LLM), gamma = gamma-decision (Laya), delta = delta-function-call.
# По умолчанию все три локально. Уберите профиль — модель работает на другой машине,
# и её *_BASE_URL обязательно нужно задать ниже (иначе оркестратор пойдёт на недоступный
# compose-сервис). `docker compose up` без COMPOSE_PROFILES не поднимет ни одной модели.
COMPOSE_PROFILES=beta,gamma,delta

# Настройки моделей для alpha-orchestrator. Пусто = значение по умолчанию приложения.
# *_MAX_CONCURRENCY должен совпадать с числом параллельных слотов сервера модели
# (beta: PARALLEL выше, delta: DELTA_PARALLEL, внешний сервер — его настройки).
# LLM_TEMPERATURE выше читает и llama-server beta-text (--temp), и оркестратор.
#LLM_BASE_URL=http://beta-text:8080/v1
#LLM_MODEL=
#LLM_MAX_CONCURRENCY=
#LAYA_API_BASE_URL=http://gamma-decision:8080
#LAYA_MODEL=
#LAYA_MAX_CONCURRENCY=
#FUNCTION_CALL_BASE_URL=http://delta-function-call:8080/v1
#FUNCTION_CALL_MODEL=
#FUNCTION_CALL_TEMPERATURE=
#FUNCTION_CALL_REASONING_EFFORT=
#FUNCTION_CALL_MAX_CONCURRENCY=
# Локальный delta-function-call: слоты и потоки llama-server.
#DELTA_PARALLEL=1
#DELTA_THREADS=2

# Пример: все модели на внешней машине, локально ни одной (перевод Opus-MT
# всегда внутри alpha-orchestrator, внешнего режима у него нет).
# beta и delta — Ollama (OpenAI-совместимый /v1), Laya — gamma-decision там же.
#COMPOSE_PROFILES=
#LLM_BASE_URL=http://192.168.100.39:11434/v1
#LLM_MODEL=hf.co/Vikhrmodels/Vikhr-Llama-3.2-1B-instruct-GGUF:Q4_K_M
#FUNCTION_CALL_BASE_URL=http://192.168.100.39:11434/v1
#FUNCTION_CALL_MODEL=qwen3:1.7b-q8_0
# Ollama + Qwen3 иначе включает thinking.
#FUNCTION_CALL_REASONING_EFFORT=none
#LAYA_API_BASE_URL=http://192.168.100.39:8091
