# Dev server only (vite.config.ts); the built panel is static and reads none of these at runtime.

# Where the dev server proxies /api: apps/admin-api.
# ADMIN_API_URL=http://localhost:3003

# Editor the Svelte inspector opens (Alt+X, click an element): code, webstorm, zed, …
# LAUNCH_EDITOR=webstorm

# Sentry for the panel; baked in at build time (CI sets it in .github/workflows/orchestra.yml). Empty = off.
VITE_SENTRY_DSN=
