# alpha-orchestrator base URL. In compose it's overridden to http://alpha-orchestrator:3000.
HARNESS_BASE_URL=http://localhost:3000
# Secret for the orchestrator's /v1/admin/* (same value as alpha-orchestrator's ADMIN_API_KEY).
# In compose it comes from the root .env.
ADMIN_API_KEY=

# better-auth: signing secret (≥32 chars, e.g. `openssl rand -base64 32`) and the
# public URL the admin panel is opened at.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002

# The admin app's own SQLite (admin accounts only). The Docker image sets both.
ADMIN_DATABASE_PATH=./data/admin.db
ADMIN_MIGRATIONS_DIR=./drizzle
