{
	"name": "admin",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev --port 3002",
		"build": "bun --bun vite build",
		"start": "bun ./build/index.js",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test src",
		"check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"lint": "biome check .",
		"db:generate": "drizzle-kit generate",
		"auth:schema": "bunx --bun @better-auth/cli generate --config src/lib/server/auth-cli.ts --output src/lib/server/db/auth-schema.ts -y"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@humanspeak/svelte-virtual-chat": "^0.1.23",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/svelte-table": "^9.2.4",
		"@types/bun": "^1.4.2",
		"@xyflow/svelte": "^1.6.6",
		"better-auth": "^1.7.5",
		"bits-ui": "^2.18.0",
		"cn": "^0.4.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"layerchart": "^2.0.0",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"zod": "^4.6.5"
	}
}
