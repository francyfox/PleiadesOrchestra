{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": [
			"**",
			"!src/lib/components/ui",
			"!src/lib/server/db/auth-schema.ts",
			"!src/lib/utils.ts",
			"!drizzle"
		]
	},
	"html": {
		"formatter": {
			"indentScriptAndStyle": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useConst": "off",
						"useImportType": "off"
					}
				}
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
