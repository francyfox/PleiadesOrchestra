TELEGRAM_TOKEN=

# Standalone-run default (compose overrides this to the compose-network
# hostname — see compose.yml).
HARNESS_BASE_URL=http://localhost:3000
HARNESS_API_KEY=

PORT=3000
# Webhook mode needs a publicly reachable URL — point this at a tunnel
# (ngrok/cloudflared) forwarding to this service's PORT, e.g.
# https://<your-tunnel>.ngrok-free.app/webhook. Tunnel it to localhost:3001 (compose.yml's telegram-bot port).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
