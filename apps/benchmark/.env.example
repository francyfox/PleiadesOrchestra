# delta (Qwen3 llama-server) already running elsewhere, e.g. on another machine.
# Unset: `bun tools` starts one locally in Docker. With or without /v1.
DELTA_BASE_URL=
# delta's API_KEY (FUNCTION_CALL_API_KEY in the root .env).
DELTA_API_KEY=
# Model name sent with each request: Ollama needs it, llama-server ignores it.
DELTA_MODEL=
# A Laya server root (gamma-decision, or the same API on a GPU box); the client appends /v1/systemone.
# Unset: Laya loads in the benchmark's own process (CPU).
LAYA_BASE_URL=
LAYA_API_KEY=

# `bun openrouter`: delta's candidate models on OpenRouter side by side.
OPENROUTER_API_KEY=

# `bun efficiency`: beta alone vs the orchestrator with beta on a mock shop, both through the orchestrator.
ORCHESTRA_BASE_URL=
# HARNESS_API_KEY of the orchestrator (beta alone goes through POST /v1/chat/completions).
ORCHESTRA_API_KEY=
# One of its web channels (admin: Channels -> publishable key, allowed origin).
ORCHESTRA_PUBLISHABLE_KEY=
ORCHESTRA_ORIGIN=
# Optional: ADMIN_API_KEY of the orchestrator, to count Laya/delta/alpha-understand calls too.
ORCHESTRA_ADMIN_API_KEY=
# `bun replay`: the local models' OpenAI-compatible server (a llama-server router, with /v1) and its key
REPLAY_BASE_URL=
REPLAY_API_KEY=
