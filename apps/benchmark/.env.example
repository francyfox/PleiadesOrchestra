# delta (Qwen3 llama-server) already running elsewhere, e.g. on another machine.
# Unset: `bun tools` starts one locally in Docker. With or without /v1.
DELTA_BASE_URL=
# delta's API_KEY (FUNCTION_CALL_API_KEY in the root .env).
DELTA_API_KEY=
# Model name sent with each request: Ollama needs it, llama-server ignores it.
DELTA_MODEL=
# A Laya server root (gamma-decision, or the same API on a GPU box); the client appends /v1/systemone.
# Unset: Laya loads in the benchmark's own process (CPU).
LAYA_BASE_URL=
LAYA_API_KEY=
