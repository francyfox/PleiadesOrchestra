PORT=8080

# Shared secret — apps/alpha-orchestrator's DecisionAgent sends this as
# `Authorization: Bearer <key>` to reach this service.
LAYA_API_KEY=

# HuggingFace repo the ONNX bundle is downloaded from on first use (cached
# under ~/.cache/receptron-laya afterwards). Leave the default unless you're
# pointing at a private/forked bundle.
LAYA_MODEL_REPO=receptron/laya-onnx

# Optional subfolder inside that repo, e.g. "multilingual". Empty = the
# English checkpoint at the repo root.
LAYA_MODEL_SUBFOLDER=

# onnxruntime threads for Laya: number of *physical* cores (6 on the Ryzen 5
# 5600H), not logical ones — SMT siblings slow it down. 0 = onnxruntime default.
LAYA_THREADS=6
