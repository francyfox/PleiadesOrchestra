{
	"name": "alpha-orchestrator",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"build": "bun build ./src/index.ts --compile --target=bun-linux-x64-musl --outfile dist/harness",
		"test": "bun test",
		"check-types": "tsc --noEmit",
		"lint": "biome check .",
		"db:generate": "drizzle-kit generate",
		"import:telegram-whitelist": "bun scripts/import-telegram-whitelist.ts"
	},
	"dependencies": {
		"@elysiajs/swagger": "^1.3.1",
		"@repo/core": "workspace:*",
		"@t3-oss/env-core": "^0.13.11",
		"drizzle-orm": "^0.45.3",
		"elysia": "^1.4.29",
		"transferum": "^1.7.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.3.12",
		"drizzle-kit": "^0.31.11",
		"typescript": "^5.9.3"
	}
}
