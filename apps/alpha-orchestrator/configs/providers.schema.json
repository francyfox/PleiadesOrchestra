{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"providers": {
			"default": {},
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[a-z0-9][a-z0-9-]*$"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"base_url": {
						"type": "string",
						"format": "uri"
					},
					"decisions_url": {
						"type": "string",
						"format": "uri"
					},
					"type": {
						"type": "string",
						"enum": [
							"openai-compat",
							"systemone"
						]
					},
					"api_key": {
						"type": "string"
					},
					"models": {
						"default": [],
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string",
									"minLength": 1
								},
								"name": {
									"type": "string"
								},
								"types": {
									"minItems": 1,
									"type": "array",
									"items": {
										"type": "string",
										"enum": [
											"language",
											"embedding",
											"image",
											"video",
											"speech",
											"transcription",
											"reranking",
											"decision"
										]
									}
								},
								"type": {
									"type": "string",
									"enum": [
										"language",
										"embedding",
										"image",
										"video",
										"speech",
										"transcription",
										"reranking",
										"decision"
									]
								},
								"temperature": {
									"type": "number",
									"minimum": 0,
									"maximum": 2
								},
								"reasoning_effort": {
									"type": "string",
									"enum": [
										"none",
										"low",
										"medium",
										"high"
									]
								},
								"extra_body": {
									"type": "object",
									"propertyNames": {
										"type": "string"
									},
									"additionalProperties": {}
								}
							},
							"required": [
								"id"
							]
						}
					}
				}
			}
		}
	}
}
