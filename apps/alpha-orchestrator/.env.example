PORT=3000

# Shared secret transport adapters (telegram-bot, ...) send as
# `Authorization: Bearer <key>` to reach this service.
HARNESS_API_KEY=

# Standalone-run defaults — the exposed compose host ports (compose.yml maps
# albedo/laya-api to 8181/8090). Running harness inside compose overrides
# both to the compose-network hostnames instead (see compose.yml).
LLM_BASE_URL=http://localhost:8181/v1
LLM_API_KEY=
LLM_MODEL=vikhr-llama-3.2-1b

LAYA_API_BASE_URL=http://localhost:8090
LAYA_API_KEY=

# Translating a message to English as it comes in (libtranslator.so from
# native/build.sh + an Opus-MT CTranslate2 model). Leave the path empty = no
# translation. In compose the Docker image sets these.
TRANSLATE_LIB_PATH=
# TRANSLATE_MODEL_DIR=/models/opus-ru-en
# TRANSLATE_THREADS=4
# TRANSLATE_WORKERS=1

# delta-function-call (compose maps it to 8282): writes the JSON arguments of
# WebMCP tool calls. Leave the URL empty to build arguments from facts instead.
FUNCTION_CALL_BASE_URL=http://localhost:8282/v1
# Same value as FUNCTION_CALL_API_KEY in the root .env (compose requires it for delta-function-call).
FUNCTION_CALL_API_KEY=
FUNCTION_CALL_MODEL=qwen3-1.7b

# SQLite database (users, last messages, token usage, GOAP traces).
DATABASE_PATH=./data/orchestrator.db
# Unset = the repo's drizzle/ folder. The Docker image sets it to /app/drizzle.
# DATABASE_MIGRATIONS_DIR=

# Secret apps/admin-api sends as `Authorization: Bearer <key>` to /v1/admin/*.
# Must differ from HARNESS_API_KEY. In compose it comes from the root .env.
ADMIN_API_KEY=

# Comma-separated browser origins allowed to call /v1/admin/requests/* (CORS).
# The token is still required on every actual request — CORS only allows the
# browser to send the cross-origin fetch at all.
ADMIN_CORS_ORIGINS=https://shalotts.site

# Messages kept per user (across all threads); must be ≥ the agent's history window (10).
MESSAGE_RETENTION_PER_USER=10

# Salt for hashing IP addresses in blocked-ips. Any random string.
IP_HASH_SALT=

# Anonymous chat users (widget visitors) inactive longer than this are deleted.
# Also the sliding lifetime of a widget visitor token.
ANON_RETENTION_HOURS=24

# A thread's persisted GOAP WorldState (stuck/abandoned plan run) not updated
# for this long is deleted. Covers identified users' threads, which aren't
# cleared by ANON_RETENTION_HOURS.
WORLD_STATE_RETENTION_HOURS=24

# Shop chat widget (/v1/widget/*) abuse limits, in-memory.
WIDGET_MAX_TEXT_CHARS=2000
# POST /v1/widget/tools (registered once per panel-open, not per message) — a
# real WebMCP catalog is several kB on its own, well past WIDGET_MAX_TEXT_CHARS.
WIDGET_MAX_WEBMCP_TOOLS_CHARS=20000
# Request body caps in bytes: whole server (Bun maxRequestBodySize) and the
# stricter check on public /v1/widget/* (by Content-Length).
HTTP_MAX_BODY_BYTES=1048576
WIDGET_MAX_BODY_BYTES=131072
# Threads one visitor may create per hour; classified WebMCP catalogs kept in
# memory (LRU, also expire after ANON_RETENTION_HOURS).
WIDGET_THREADS_PER_HOUR=30
WIDGET_MAX_CATALOG_THREADS=1000
WIDGET_MESSAGES_PER_MINUTE=10
WIDGET_IP_MESSAGES_PER_MINUTE=30
WIDGET_VISITORS_PER_HOUR_PER_IP=20
# Where the client IP for per-IP limits and IP blocks comes from:
#   socket            — TCP peer address (no proxy in front; safe default)
#   cf-connecting-ip  — Cloudflare's CF-Connecting-IP (only if ALL traffic
#                       comes through Cloudflare; compose.yml sets this)
#   xff-rightmost     — X-Forwarded-For, TRUSTED_PROXY_HOPS-th entry from the
#                       right (1 = rightmost; the left side is client-forged)
# Missing/short header → falls back to the socket address.
CLIENT_IP_SOURCE=socket
TRUSTED_PROXY_HOPS=1

# Logging and error monitoring (shared by every Elysia service). No DSN = Sentry off.
LOG_LEVEL=info
SENTRY_DSN=

