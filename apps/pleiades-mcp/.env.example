# The orchestrator this MCP server talks to (same key as the transports use).
HARNESS_BASE_URL=http://localhost:3000
HARNESS_API_KEY=

# Sites this server may talk about: slug=host pairs, where slug is the orchestrator channel of that site.
# Empty = no sites, every task answers not_applicable.
PLEIADES_SITES=

# External user id the orchestrator sees for every call from this server.
# PLEIADES_MCP_USER=mcp
