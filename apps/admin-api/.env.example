# HTTP port. Compose maps it to the host; the panel's nginx proxies /api here.
PORT=3003

# alpha-orchestrator base URL. In compose it's overridden to http://alpha-orchestrator:3000.
HARNESS_BASE_URL=http://localhost:3000
# Secret for the orchestrator's /v1/admin/* (same value as alpha-orchestrator's ADMIN_API_KEY).
# In compose it comes from the root .env.
ADMIN_API_KEY=

# better-auth: signing secret (≥32 chars, e.g. `openssl rand -base64 32`) and the
# public URL the admin panel is opened at.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002
# Origins allowed to make state-changing requests (comma-separated). localhost and
# 127.0.0.1 are different origins to a browser, so list every address you open the panel at.
ADMIN_TRUSTED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Mail for customer accounts (verification, password reset) through SMTP (nodemailer).
# Without SMTP_PASS nothing is sent: the subject and link are written to the log (local dev).
# Gmail: smtp.gmail.com:465 with an app password; the address in SMTP_FROM must be the account's own or an alias.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=info@shalotts.site
SMTP_PASS=
# SMTP_FROM=info@shalotts.site
# Origin the links in those mails point at (default: BETTER_AUTH_URL).
# PUBLIC_PANEL_URL=http://localhost:3002

# This service's own SQLite (admin accounts only). Leave ADMIN_DATABASE_PATH and
# ADMIN_MIGRATIONS_DIR unset: the defaults (./data/admin.db, ./drizzle) suit `bun run dev`,
# and compose pins the container paths — a relative path here would override the image's.
# ADMIN_DATABASE_PATH=../../data/admin/admin.db   # e.g. to reuse the compose DB locally

# Polar billing: checkout and the customer portal. Without POLAR_ACCESS_TOKEN they answer 503
# `billing_unavailable` and deleting an account cancels nothing. Product ids as in alpha-orchestrator's .env.
# POLAR_SERVER=sandbox          # sandbox | production
POLAR_ACCESS_TOKEN=
# POLAR_PLAN_PRODUCT_ID=
# POLAR_CREDITS_PRODUCT_ID=

# Where the client IP comes from (login throttling, session records): socket | cf-connecting-ip | xff-rightmost.
# admin-api is bound to 127.0.0.1 and reached directly, so keep `socket`. Headers are only trusted
# when every request really passes through that proxy (TRUSTED_PROXY_HOPS = proxies appending to X-Forwarded-For).
# CLIENT_IP_SOURCE=socket
# TRUSTED_PROXY_HOPS=1
# Login lockout: failures per account / per IP within the window lock it for the rest of the window (429).
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_LOCKOUT_MINUTES=15

# How often /api/system/stream (the panel's header meter) pushes a host snapshot while a tab is open.
# SYSTEM_STREAM_INTERVAL_MS=15000

# Logging and error monitoring (shared by every service). No DSN = Sentry off.
LOG_LEVEL=info
SENTRY_DSN=
# Share of requests traced as spans (0..1); each span counts against the Sentry quota.
SENTRY_TRACES_SAMPLE_RATE=0.1
# The admin panel's own Sentry DSN (its VITE_SENTRY_DSN): /api/monitoring/tunnel forwards only
# its envelopes, so ad blockers can't drop them. Unset = no tunnel.
SENTRY_TUNNEL_DSN=
