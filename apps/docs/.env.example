# Playground widget (public: these end up in the browser bundle, publishable keys only).
# The orchestrator the widget talks to (alpha-orchestrator, public origin).
PUBLIC_PLEIADES_AGENT_URL=http://localhost:3000

# Shared fallback channel (pk_...). Used by every demo that has no key of its own below;
# the playground then calls el.resetSession() when the demo changes.
PUBLIC_PLEIADES_KEY=

# Optional: one channel per demo (pk_...). Unset = the shared key above.
PUBLIC_PLEIADES_KEY_BASKETFUL=
PUBLIC_PLEIADES_KEY_PIZZA_MAKER=
PUBLIC_PLEIADES_KEY_EXPLAINER=
PUBLIC_PLEIADES_KEY_FLIGHT_SEARCH=
PUBLIC_PLEIADES_KEY_TICKET_BOOKING=
PUBLIC_PLEIADES_KEY_HOTEL_CHAIN=
