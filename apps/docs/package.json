{
	"name": "docs",
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"author": "Danil Golota",
	"private": true,
	"type": "module",
	"devDependencies": {
		"@lucide/svelte": "^1.48.0",
		"@repo/ui": "workspace:*",
		"@repo/webmcp-polyfill": "workspace:*",
		"@shalotts/pleiades-widget": "workspace:*",
		"@splidejs/splide": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@sveltepress/theme-default": "catalog:",
		"@sveltepress/vite": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-meta-tags": "5.0.3",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"scripts": {
		"dev": "bun run polyfill && bun --bun vite dev --port 3004",
		"build": "bun run polyfill && bun --bun vite build",
		"preview": "bun --bun vite preview --port 3004",
		"prepare": "svelte-kit sync || echo ''",
		"check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"lint": "biome check .",
		"polyfill": "bun build vite/webmcp-polyfill.entry.ts --format=iife --minify --banner='/*! WebMCP polyfill, adapted from GoogleChromeLabs/webmcp-tools. Copyright 2026 Google LLC, Copyright 2026 Danil Golota. SPDX-License-Identifier: Apache-2.0 */' --outfile=static/playground-demos/shared/webmcp-polyfill.js"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
