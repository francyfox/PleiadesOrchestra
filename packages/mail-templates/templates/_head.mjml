<mjml>
<mj-head>
	<mj-title>{{title}}</mj-title>
	<!-- The design system's fonts (packages/ui): Poppins has no Cyrillic, so ru text falls through to Montserrat. Gmail ignores web fonts and uses the system stack. -->
	<mj-font name="Poppins" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&amp;display=swap" />
	<mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&amp;display=swap" />
	<mj-attributes>
		<mj-all font-family="Poppins, Montserrat, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
		<mj-text color="#ffffff" font-size="16px" line-height="1.6" />
	</mj-attributes>
	<!-- Colours: the admin panel's dark theme, apps/admin/src/routes/layout.css (oklch converted to hex; mail clients don't read oklch).
	     Dark only: clients that half-apply prefers-color-scheme overrides left light text on a light card. -->
	<mj-style>
		:root { color-scheme: dark; supported-color-schemes: dark; }
	</mj-style>
</mj-head>
</mjml>
