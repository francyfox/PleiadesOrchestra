{
	"name": "albedo",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:albedo": "bun test test/docker.test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/bun": "latest",
		"turbo": "^2.10.8",
		"typescript": "^5.9.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
