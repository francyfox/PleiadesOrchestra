{
	"name": "pleiades-orchestra",
	"private": true,
	"license": "AGPL-3.0-only",
	"author": "Danil Golota",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:beta-text": "bun test apps/beta-text/docker.test.ts",
		"test:e2e": "cd packages/pleiades-widget && bun run build && cd ../../apps/e2e && bun run test:e2e",
		"knip": "knip",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/bun": "^1.3.14",
		"husky": "^9.1.7",
		"turbo": "^2.10.9",
		"typescript": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.3"
		}
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"!apps/pleiades-plugin"
		],
		"catalog": {
			"elysia": "1.4.29",
			"@elysiajs/openapi": "^1.4.16",
			"@sentry/elysia": "11.4.0",
			"@sentry/sveltekit": "11.4.0",
			"@sinclair/typebox": "^0.34.52",
			"drizzle-orm": "^0.45.3",
			"drizzle-kit": "^0.31.11",
			"drizzle-typebox": "^0.3.3",
			"@t3-oss/env-core": "^0.13.11",
			"zod": "^4.6.5",
			"nodemailer": "^10.1.7",
			"mjml": "^5.4.1",
			"@types/mjml": "^4.7.4",
			"@types/nodemailer": "^8.0.2",
			"@bunli/core": "^0.9.1",
			"@bunli/utils": "^0.6.0",
			"consola": "^3.4.2",
			"@paralleldrive/cuid2": "^3.0.6",
			"@types/bun": "^1.3.14",
			"typescript": "^6.0.3",
			"ai": "7.0.141",
			"@ai-sdk/openai-compatible": "3.0.69",
			"@ai-sdk/typesafe-ai": "3.0.19",
			"svelte": "^5.57.1",
			"@sveltejs/kit": "^3.0.0",
			"@sveltejs/adapter-static": "^4.0.0",
			"@sveltejs/vite-plugin-svelte": "^7.1.2",
			"vite": "^8.0.16",
			"svelte-check": "^4.7.5",
			"tailwindcss": "^4.3.0",
			"@tailwindcss/vite": "^4.3.0",
			"@sveltepress/vite": "1.10.0",
			"@sveltepress/theme-default": "8.11.0",
			"@codemirror/state": "6.7.6",
			"@codemirror/view": "6.43.15",
			"@codemirror/language": "6.13.1",
			"@codemirror/legacy-modes": "6.5.5",
			"@codemirror/lint": "6.9.7",
			"@codemirror/commands": "6.11.1",
			"@lezer/highlight": "1.2.5"
		}
	}
}
