{
	"name": "pleiades-orchestra",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:beta-text": "bun test apps/beta-text/docker.test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/bun": "^1.3.14",
		"turbo": "^2.10.9",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
