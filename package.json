{
	"name": "pleiades-orchestra",
	"private": true,
	"license": "AGPL-3.0-only",
	"author": "Danil Golota",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:beta-text": "bun test apps/beta-text/docker.test.ts",
		"test:e2e": "cd packages/pleiades-widget && bun run build && cd ../../apps/e2e && bun run test:e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/bun": "^1.3.14",
		"turbo": "^2.10.9",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14"
		}
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"!apps/pleiades-plugin"
		],
		"catalog": {
			"elysia": "^1.4.29",
			"@elysiajs/openapi": "^1.4.16",
			"@sinclair/typebox": "^0.34.52",
			"drizzle-orm": "^0.45.3",
			"drizzle-kit": "^0.31.11",
			"drizzle-typebox": "^0.3.3",
			"@t3-oss/env-core": "^0.13.11",
			"zod": "^4.6.5",
			"consola": "^3.4.2",
			"@types/bun": "^1.3.14",
			"typescript": "^6.0.3"
		}
	}
}
