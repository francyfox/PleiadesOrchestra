# npm registry auth: the token is read from the environment, never written here.
# Publishing: `export NPM_TOKEN=npm_...` in the shell, then `bun publish` from packages/pleiades-widget.
# Bun reads .npmrc from the repo root only, and expands ${NPM_TOKEN} from the shell
# environment (a .env file inside the package is not used for this).
registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
